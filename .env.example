# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.

OPENROUTER_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5

# Added by the build (all optional; defaults shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RETRIEVAL_THRESHOLD=0.40
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_CACHE_DIR=./storage/llm_cache
KILL_SWITCH=false
METRICS_PORT=8001
ANSWERABLE_FLOOR=0
PLAN_RULE=false
GROUNDING_COS=0.50
GROUNDING_LEX=0.50
GROUNDING_CONTRADICTION=0.85
GROUNDING_NLI=true
