{
  "title": "CloudServe support pipeline",
  "uid": "cloudserve-support",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s",
  "tags": ["cloudserve", "support-pipeline"],
  "templating": {"list": []},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Tickets per hour by channel and outcome",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (channel, outcome) (increase(tickets_processed_total[1h]))", "legendFormat": "{{channel}} / {{outcome}}"}]
    },
    {
      "id": 2, "type": "stat", "title": "Answered automatically vs escalated (last hour)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [
        {"refId": "A", "expr": "sum(increase(tickets_processed_total{outcome=\"auto_respond\"}[1h])) / sum(increase(tickets_processed_total[1h]))", "legendFormat": "auto-answered"},
        {"refId": "B", "expr": "sum(increase(tickets_processed_total{outcome=~\"escalate|block\"}[1h])) / sum(increase(tickets_processed_total[1h]))", "legendFormat": "escalated or blocked"}
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Response latency, median and p95",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(response_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(response_seconds_bucket[5m])))", "legendFormat": "p95"}
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Guardrail activations by guardrail",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (guardrail) (increase(guardrail_blocks_total[1h]))", "legendFormat": "{{guardrail}}"}]
    },
    {
      "id": 5, "type": "barchart", "title": "Confidence distribution (last hour)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(classification_confidence_bucket[1h]))", "legendFormat": "<= {{le}}", "format": "table", "instant": true}]
    },
    {
      "id": 6, "type": "timeseries", "title": "Pipeline failures by stage",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (stage) (increase(pipeline_failures_total[1h]))", "legendFormat": "{{stage}}"}]
    }
  ]
}
