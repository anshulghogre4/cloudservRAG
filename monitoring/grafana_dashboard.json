      },
      "gridPos": {
        "x": 17,
        "y": 14,
        "w": 7,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (classification_confidence_bucket)",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "orientation": "vertical",
